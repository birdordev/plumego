{
  "name": "plumego-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "sync": "node ./scripts/sync-all.mjs",
    "dev": "pnpm sync && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "pnpm sync && pnpm check:api && pnpm build:site",
    "build:site": "ASTRO_TELEMETRY_DISABLED=1 astro build && node ./scripts/check-rendered-asides.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "translations:check": "node ./scripts/check-translation-lag.mjs --strict",
    "check": "pnpm translations:check && pnpm sync && pnpm check:site",
    "check:api": "node ./scripts/check-doc-api-symbols.mjs",
    "check:site": "node ./scripts/check-content-contracts.mjs && pnpm check:api && ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/sitemap": "3.7.5",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.12",
    "typescript": "^7.0.2"
  }
}
