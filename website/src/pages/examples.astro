---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import JourneyBar from '../components/marketing/JourneyBar.astro';
import DirectoryTree from '../components/marketing/DirectoryTree.astro';
import { EXAMPLES_COPY } from '../data/site';

const copy = EXAMPLES_COPY.en;

const journeySteps = [
  { label: 'Why Plumego', href: '/why-plumego' },
  { label: 'Extensions', href: '/extensions' },
  { label: 'Examples', href: '/examples' },
  { label: 'Releases', href: '/releases' },
];

const smallestExamples = [
  {
    kicker: 'smallest',
    title: 'examples/hello',
    body: 'The simplest Plumego service: one endpoint, JSON response. Under 50 lines of code.',
    href: 'https://github.com/birdordev/plumego/tree/main/examples/hello',
    label: 'Open on GitHub →',
  },
  {
    kicker: 'error handling',
    title: 'examples/error-handling',
    body: 'Validation errors, request binding errors, panic recovery, and the structured error response envelope.',
    href: 'https://github.com/birdordev/plumego/tree/main/examples/error-handling',
    label: 'Open on GitHub →',
  },
  {
    kicker: 'standard api',
    title: 'examples/standard-api',
    body: 'A slightly larger stdlib-shaped API — routes, middleware, and item CRUD in one place. Compare against reference/standard-service.',
    href: 'https://github.com/birdordev/plumego/tree/main/examples/standard-api',
    label: 'Open on GitHub →',
  },
];

const recipeTracks = [
  {
    label: 'recipe 01',
    title: 'Request-flow recipe',
    body: 'Use this when you need to trace one HTTP request from route registration to write path without guessing where transport responsibility ends.',
    checks: ['follow route registration before handlers', 'confirm middleware order on the public path', 'stop once transport ownership ends'],
    href: '/docs/concepts/request-flow',
    cta: 'Trace one request',
    filename: 'internal/app/routes.go',
    code: `r := router.<span class="hc-fn">New</span>()

r.<span class="hc-fn">Use</span>(middleware.<span class="hc-fn">RequestID</span>())
r.<span class="hc-fn">Use</span>(middleware.<span class="hc-fn">Logger</span>(a.log))

r.<span class="hc-fn">Get</span>(<span class="hc-str">"/api/items"</span>,  a.items.<span class="hc-fn">List</span>)
r.<span class="hc-fn">Get</span>(<span class="hc-str">"/api/orders"</span>, a.orders.<span class="hc-fn">List</span>)`,
  },
  {
    label: 'recipe 02',
    title: 'Module-fit recipe',
    body: 'Use this when the real question is whether your work belongs in stable roots, app-local wiring, or an extension module.',
    checks: ['classify the change before opening packages', 'protect stable-root compatibility promises', 'push optional capability work outward'],
    href: '/extensions',
    cta: 'Classify the change',
    filename: 'import path check',
    code: `<span class="hc-cm">// stable root — stable-root candidate, evaluate first</span>
<span class="hc-kw">import</span> <span class="hc-str">"github.com/birdordev/plumego/router"</span>
<span class="hc-kw">import</span> <span class="hc-str">"github.com/birdordev/plumego/middleware"</span>

<span class="hc-cm">// extension family — Experimental, evaluate first</span>
<span class="hc-kw">import</span> <span class="hc-str">"github.com/birdordev/plumego/x/tenant"</span>
<span class="hc-kw">import</span> <span class="hc-str">"github.com/birdordev/plumego/x/ai"</span>`,
  },
  {
    label: 'recipe 03',
    title: 'Reference-app recipe',
    body: 'Use this when you want to inspect the canonical service shape and compare your own bootstrap and route layout against it.',
    checks: ['start from internal/app ownership', 'compare directory shape before adding abstractions', 'treat the reference app as the reusable baseline'],
    href: '/docs/reference-app',
    cta: 'Read the reference app',
    filename: 'internal/app/app.go',
    code: `<span class="hc-kw">type</span> App <span class="hc-kw">struct</span> &#123;
    log    log.Logger
    db     *sql.DB
    items  *items.Handler
    orders *orders.Handler
&#125;

<span class="hc-kw">func</span> <span class="hc-fn">New</span>(cfg *config.Config, deps AppDeps) *App &#123;
    <span class="hc-kw">return</span> &App&#123; <span class="hc-cm">/* explicit wiring */</span> &#125;
&#125;`,
  },
  {
    label: 'recipe 04',
    title: 'Maturity-check recipe',
    body: 'Use this when adoption depends on compatibility signals rather than on whether a package simply exists in the repository.',
    checks: ['read stability promises before expanding scope', 'separate module maturity from roadmap ambition', 'keep evidence ahead of assumptions'],
    href: '/docs/release-posture',
    cta: 'Check module maturity',
    filename: 'maturity boundary',
    code: `<span class="hc-cm">// GA stable roots — v1 compatibility promise</span>
core, router, contract, middleware
security, store, health, log, metrics

<span class="hc-cm">// Beta — API frozen between minor release refs</span>
x/rest, x/gateway, x/websocket, x/observability
x/tenant, x/frontend, x/messaging

<span class="hc-cm">// Experimental — useful, but API may change</span>
x/ai, x/data, x/fileapi, x/resilience`,
  },
  {
    label: 'recipe 05',
    title: 'Repository-shape recipe',
    body: 'Use this when a change spans docs, generated facts, and implementation work and you need to know which layer owns what.',
    checks: ['use docs for learning paths', 'use specs and generated facts for source-of-truth signals', 'keep app-local code and extensions clearly separated'],
    href: '/architecture',
    cta: 'Open architecture',
    filename: 'repo layer map',
    code: `docs/    <span class="hc-cm">← human-readable learning paths</span>
specs/   <span class="hc-cm">← machine-readable rules &amp; ownership</span>
tasks/   <span class="hc-cm">← executable work cards</span>
x/       <span class="hc-cm">← capability extension families</span>

<span class="hc-cm">// app-local: only in your service repo</span>
internal/app/app.go
internal/app/routes.go`,
  },
] as const;

const adoptionChecks = [
  'Run the reference app before opening unrelated package families.',
  'Use recipes to answer a specific question, not as parallel product demos.',
  'Return to the docs path once you know which boundary or capability owns the change.',
] as const;

const readingOrder = [
  {
    label: '01',
    title: 'Run the canonical service first',
    body: 'Start with reference/standard-service so the bootstrap model, route ownership, and handler shape all have one default baseline.',
    href: '/docs/reference-app',
    cta: 'Start with the runnable path',
  },
  {
    label: '02',
    title: 'Use recipes to answer one concrete question',
    body: 'Pick a recipe only after you know what you are trying to inspect: request flow, module fit, module maturity, or repository shape.',
    href: '/docs/concepts/request-flow',
    cta: 'Open a focused recipe',
  },
  {
    label: '03',
    title: 'Return to docs for durable guidance',
    body: 'Recipes point back into docs so the canonical path stays central and the site does not turn examples into a disconnected showcase.',
    href: '/docs/getting-started',
    cta: 'Continue in docs',
  },
  {
    label: '04',
    title: 'Check module maturity before expanding scope',
    body: 'Once you understand the default path, use the status page to confirm module maturity and v1 readiness before widening adoption scope.',
    href: '/status',
    cta: 'Check project status',
  },
] as const;
---

<MarketingLayout
  locale="en"
  title={copy.title}
  description={copy.description}
  currentPath="/examples"
  keywords={['plumego examples', 'go http example', 'reference standard service', 'plumego reference app']}
>
  <PageHero
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
    visual="examples"
    links={[
      { label: 'Architecture', href: '/architecture' },
      { label: 'Docs', href: '/docs' },
    ]}
  />

  <JourneyBar steps={journeySteps} current="/examples" />

  <section class="section section--code-lead">
    <div class="section__intro">
      <h2>Start from one runnable service.</h2>
      <p>Clone and run the reference service before opening guides or recipes. Every example in this page assumes you have already run this path.</p>
    </div>
    <div class="hero__install" style="max-width:600px;margin:0 auto">
      <code class="hero__install-cmd">cd plumego/reference/standard-service &amp;&amp; go run .</code>
    </div>
    <div style="max-width:600px;margin:1.5rem auto 0">
      <div class="dir-tree">
        <div class="dir-tree__bar">
          <div class="dir-tree__dots"><span></span><span></span><span></span></div>
          <span class="dir-tree__title">terminal — then verify</span>
        </div>
        <div class="dir-tree__body">
          <span><span class="dir-tree__dim">$ </span><span class="dir-tree__key">curl</span> localhost:8080/healthz</span>
          <span class="dir-tree__note" set:text={'# {"data":{"status":"ok"}}'}></span>
          <span><span class="dir-tree__dim">$ </span><span class="dir-tree__key">curl</span> "localhost:8080/api/v1/greet?name=Alice"</span>
          <span class="dir-tree__note" set:text={'# {"data":{"message":"hello, Alice"}}'}></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__intro">
      <h2>{copy.introTitle}</h2>
      <p>{copy.introBody}</p>
    </div>
    <div class="signal-list">
      {copy.guideCards.map((item) => (
        <article class="signal-list__item">
          <p class="signal-list__kicker">{item.kicker}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Canonical example with directory tree + run command -->
  <section class="section section--tinted">
    <div class="section__intro">
      <h2>One canonical service, then guided recipes.</h2>
      <p>
        Plumego examples are intentionally layered. There is one canonical runnable service, and there are guided recipes that explain how to
        read the repository around it without pretending every problem needs a separate demo app.
      </p>
    </div>
    <div class="example-hierarchy">
      <article class="example-hierarchy__primary">
        <p class="signal-list__kicker">canonical example</p>
        <h3>reference/standard-service</h3>
        <p>
          The primary example is the service you can clone, run, compare against your own repository, and keep returning to while adoption
          decisions are still forming.
        </p>
        <ul>
          <li>bootstrap and server construction stay visible</li>
          <li>internal/app owns application-local wiring</li>
          <li>route registration stays readable before deeper handlers or package families</li>
        </ul>

        <!-- Directory tree -->
        <DirectoryTree />

        <!-- Run command -->
        <div class="dir-tree example-command">
          <div class="dir-tree__bar">
            <div class="dir-tree__dots"><span></span><span></span><span></span></div>
            <span class="dir-tree__title">terminal</span>
          </div>
          <div class="dir-tree__body example-command__body">
            <span><span class="dir-tree__dim">$ </span><span class="dir-tree__key">go run</span> ./reference/standard-service</span>
            <span class="dir-tree__note"># Server started at :8080</span>
          </div>
        </div>

        <a class="text-link" href="/docs/reference-app">Open the reference app guide</a>
      </article>
      <article class="example-hierarchy__secondary">
        <p class="signal-list__kicker">guided recipes</p>
        <h3>Recipes answer one repository question at a time.</h3>
        <p>
          These are not parallel mini-products. They are reusable reading patterns for request flow, ownership, maturity signals, and repository
          shape.
        </p>
        <ol>
          {adoptionChecks.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
      </article>
    </div>
  </section>

  <!-- Runnable examples from copy -->
  <section class="section">
    <div class="section__intro">
      <h2>{copy.runnableTitle}</h2>
      <p>{copy.runnableBody}</p>
    </div>
    <div class="page-grid page-grid--single-emphasis">
      {copy.runnableExamples.map((item) => (
        <article class="page-panel page-panel--feature">
          <p class="signal-list__kicker">{item.kicker}</p>
          <h2>{item.title}</h2>
          <p>{item.body}</p>
          <ul>
            {item.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
          <a class="text-link" href={item.href}>{item.label}</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Smallest runnable examples from examples/ -->
  <section class="section">
    <div class="section__intro">
      <h2>Smallest runnable examples.</h2>
      <p>
        Under <code>examples/</code> there are three minimal programs — each one focuses on a single teaching point and stays small enough to read end-to-end in one sitting.
      </p>
    </div>
    <div class="page-grid">
      {smallestExamples.map((item) => (
        <article class="page-panel">
          <p class="signal-list__kicker">{item.kicker}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <div class="page-links page-links--inline">
            <a class="text-link" href={item.href}>{item.label}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Recipe tracks with inline code snippets -->
  <section class="section section--tinted">
    <div class="section__intro">
      <h2>Recipe tracks for focused adoption questions.</h2>
      <p>
        Recipes are smaller than the canonical example and more specific than a docs overview. Each one answers a concrete
        question quickly, then returns you to the default path with better classification.
      </p>
    </div>
    <div class="recipe-grid recipe-grid--expanded">
      {recipeTracks.map((item) => (
        <article class="recipe-card">
          <p class="signal-list__kicker">{item.label}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <ul class="recipe-card__checks">
            {item.checks.map((check) => (
              <li>{check}</li>
            ))}
          </ul>
          <!-- Inline code preview -->
          <div class="recipe-card__code">
            <div class="recipe-card__code-bar">{item.filename}</div>
            <pre class="recipe-card__code-pre" set:html={item.code}></pre>
          </div>
          <a class="text-link" href={item.href}>{item.cta}</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Reading order as numbered steps -->
  <section class="section">
    <div class="section__intro">
      <h2>Suggested reading order.</h2>
      <p>
        The right reading order starts with one runnable baseline, branches into one focused question, and
        then returns to docs and module maturity once the repository boundary is clear.
      </p>
    </div>
    <div class="control-grid control-grid--tight">
      {readingOrder.map((item) => (
        <article class="control-grid__item">
          <p class="signal-list__kicker">{item.label}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <a class="text-link" href={item.href}>{item.cta}</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Guided examples from copy -->
  <section class="section section--tinted">
    <div class="section__intro">
      <h2>{copy.guidedTitle}</h2>
      <p>{copy.guidedBody}</p>
    </div>
    <div class="control-grid">
      {copy.guidedExamples.map((item) => (
        <article class="control-grid__item">
          <p class="signal-list__kicker">{item.kicker}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <a class="text-link" href={item.href}>{item.label}</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Advanced reference apps: with-ai and with-tenant -->
  <section class="section">
    <div class="section__intro">
      <h2>{copy.advancedTitle}</h2>
      <p>{copy.advancedBody}</p>
    </div>
    <div class="page-grid">
      {copy.advancedExamples.map((item) => (
        <article class="page-panel page-panel--dense">
          <p class="signal-list__kicker">{item.kicker}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <p class="use-case-modules">
            <span class="use-case-modules__note">{item.maturity}</span>
          </p>
          <ul>
            {item.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
          <div class="page-links page-links--inline">
            <a class="text-link" href={item.href}>{item.label}</a>
            <a class="text-link" href={item.secondaryHref}>{item.secondaryLabel}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Full reference apps matrix -->
  <section class="section section--tinted">
    <div class="section__intro">
      <h2>{copy.referenceMatrixTitle}</h2>
      <p>{copy.referenceMatrixBody}</p>
    </div>
    <div class="comparison-table" role="table" aria-label="All Plumego capability reference apps">
      <div class="comparison-table__head" role="row">
        <strong role="columnheader">Reference app</strong>
        <strong role="columnheader">Capability</strong>
        <strong role="columnheader">Description</strong>
        <strong role="columnheader">Maturity</strong>
      </div>
      {copy.referenceMatrix.map((item) => (
        <div class="comparison-table__row" role="row">
          <span role="cell"><code>{item.name}</code></span>
          <span role="cell"><a class="text-link" href={item.href}><code>{item.kicker}</code></a></span>
          <span role="cell">{item.description}</span>
          <span role="cell">{item.maturity}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Production-scale reference: workerfleet -->
  <section class="section">
    <div class="section__intro">
      <h2>{copy.workerfleetTitle}</h2>
      <p>{copy.workerfleetBody}</p>
    </div>
    <div class="page-grid page-grid--single-emphasis">
      <article class="page-panel page-panel--feature">
        <p class="signal-list__kicker">{copy.workerfleetMaturity}</p>
        <h3>use-cases/workerfleet</h3>
        <ul>
          {copy.workerfleetDetails.map((detail) => (
            <li>{detail}</li>
          ))}
        </ul>
        <a class="text-link" href="https://github.com/birdordev/workerfleet">{copy.workerfleetLabel}</a>
      </article>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="section__intro">
      <h2>Check module maturity before expanding.</h2>
      <p>Once the default path makes sense, verify which surfaces are stable enough to adopt before widening scope.</p>
    </div>
    <div class="page-links">
      <a class="text-link" href="/status">Project status & release evidence →</a>
      <a class="text-link" href="/stability">Detailed stability tiers →</a>
    </div>
  </section>
</MarketingLayout>
