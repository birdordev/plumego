# Plumego environment variable reference
#
# Every variable below is actually read by code in this repository, grouped by
# consumer. Verify any entry with: grep -rn '"<VAR>"' --include="*.go" .
# Reference applications (reference/*) are separate modules and read their
# respective groups; the stable roots (core, router, ...) never read the
# process environment.

# ── Application basics (scaffolded by `plumego new`, all reference apps) ──
APP_ADDR=:8080
APP_ENV_FILE=.env
APP_DEBUG=false
# standard-service, with-observability also read:
APP_MAX_BODY_BYTES=10485760
# The CLI config manager (cmd/plumego) additionally recognizes:
APP_SHUTDOWN_TIMEOUT_MS=5000

# ── Observability / operations ──────────────────────────────────────
# production-service, standard-service, with-observability
APP_SERVICE_NAME=plumego-app
# with-events, with-tenant-admin
APP_LOG_LEVEL=info
# with-observability
APP_METRICS_NAMESPACE=
APP_METRICS_MAX_SERIES=
# with-ops: Bearer token and mount path for protected ops endpoints
OPS_TOKEN=
OPS_BASE_PATH=/ops
# Note: the x/observability/ops library reads AUTH_TOKEN directly from the
# process environment instead of via injected config.
AUTH_TOKEN=

# ── API protection ──────────────────────────────────────────────────
# standard-service: must be set in production for write endpoints
APP_WRITE_KEY=
# production-service
APP_API_TOKEN=

# ── TLS (production-service, standard-service, with-observability) ──
APP_TLS_ENABLED=false
APP_TLS_CERT_FILE=
APP_TLS_KEY_FILE=

# ── Rate limiting and request bounds (production-service) ───────────
APP_ENV=dev
APP_RATE_LIMIT=100
APP_RATE_BURST=200
APP_BODY_LIMIT_BYTES=10485760
APP_REQUEST_TIMEOUT=30s
APP_PROFILE_STORE_PATH=

# ── CORS (standard-service, with-observability, with-rest) ──────────
# Comma-separated origins; empty means cross-origin requests are denied.
APP_CORS_ALLOWED_ORIGINS=

# ── Tenant administration (with-tenant-admin) ───────────────────────
ADMIN_TOKEN=

# ── Gateway (with-gateway) ──────────────────────────────────────────
# Required; no default.
GATEWAY_BACKEND=

# ── WebSocket (with-websocket) ──────────────────────────────────────
# Must be at least 32 bytes.
WS_SECRET=change-me-change-me-change-me-change-me

# ── Webhooks (with-webhook + x/messaging/webhook) ───────────────────
# Inbound signature verification
GITHUB_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
# Outbound delivery (x/messaging/webhook)
WEBHOOK_ENABLED=true
WEBHOOK_TARGET_URL=
WEBHOOK_QUEUE_SIZE=2048
WEBHOOK_WORKERS=8
WEBHOOK_DROP_POLICY=block_timeout
WEBHOOK_BLOCK_WAIT_MS=50
WEBHOOK_DEFAULT_TIMEOUT_MS=5000
WEBHOOK_DEFAULT_MAX_RETRIES=6
WEBHOOK_BACKOFF_BASE_MS=500
WEBHOOK_BACKOFF_MAX_MS=30000
WEBHOOK_RETRY_ON_429=true
WEBHOOK_ALLOW_PRIVATE_NET=false
WEBHOOK_DRAIN_MAX_MS=5000
